# oytcd settings. Copy to .env.local for `make serve`; set the same names on Railway.

# Public origin, no trailing slash (https://oytc.davis7.sh in production)
OYTCD_BASE_URL=http://localhost:8080
# SQLite database file (defaults to /data/oytcd.db, the Railway volume)
OYTCD_DB_PATH=oytcd.db
# 32 random bytes, base64-encoded: openssl rand -base64 32
OYTCD_SECRET_KEY=replace-with-openssl-rand-base64-32
# Google OAuth web client; add <base>/auth/google/callback and <base>/channels/callback as redirect URIs
OYTCD_GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
# Secret of that Google OAuth web client
OYTCD_GOOGLE_CLIENT_SECRET=replace-with-client-secret
# YouTube Data API v3 key used for public data
OYTCD_YOUTUBE_API_KEY=replace-with-api-key
# Comma-separated Google accounts allowed to sign in (case-insensitive)
OYTCD_ALLOWED_EMAILS=you@example.com
# HTTP port (Railway sets this itself)
PORT=8080
