{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "cmd/oytcd/Dockerfile",
    "watchPatterns": ["cmd/oytcd/**", "internal/**", "go.mod", "go.sum"]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE"
  }
}
